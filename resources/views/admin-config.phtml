<?php

/**
 * View: sammlungen::admin-config
 * Route: GET /archiv/admin/config
 *
 * @var string                                           $title
 * @var \Sammlungen\SammlungenModule             $module
 * @var int                                              $cacheTtl
 * @var int                                              $perPage
 * @var bool                                             $apcuAvailable
 * @var \Illuminate\Support\Collection<string, \Fisharebest\Webtrees\Tree> $trees
 */

use Fisharebest\Webtrees\I18N;

?>

<div class="mt-4 mb-5">

    <h1><?= e($title) ?></h1>

    <!-- APCu-Status -->
    <div class="alert alert-<?= $apcuAvailable ? 'success' : 'warning' ?> d-flex align-items-center gap-2 mb-4">
        <i class="fas fa-<?= $apcuAvailable ? 'check-circle' : 'exclamation-triangle' ?> fs-5"></i>
        <div>
            <?php if ($apcuAvailable) : ?>
                <?= I18N::translate('APCu is active. Queries are cached.') ?>
                <small class="d-block text-muted">
                    <?= I18N::translate('Current TTL: %s seconds', $cacheTtl) ?>
                </small>
            <?php else : ?>
                <?= I18N::translate(
                    'APCu is not available. An in-process array cache is used (no caching across requests).'
                ) ?>
            <?php endif ?>
        </div>
    </div>

    <!-- Einstellungsformular -->
    <form method="post" action="<?= e(route('sammlungen.admin.config')) ?>">
        <?= csrf_field() ?>

        <div class="card mb-4">
            <div class="card-header fw-semibold">
                <i class="fas fa-sliders-h me-2"></i>
                <?= I18N::translate('General settings') ?>
            </div>
            <div class="card-body">

                <!-- Cache-TTL -->
                <div class="mb-3 row">
                    <label for="cache_ttl" class="col-sm-4 col-form-label fw-semibold">
                        <?= I18N::translate('Cache TTL (seconds)') ?>
                    </label>
                    <div class="col-sm-4">
                        <input type="number"
                               id="cache_ttl"
                               name="cache_ttl"
                               class="form-control"
                               min="60"
                               max="86400"
                               value="<?= e((string) $cacheTtl) ?>">
                        <div class="form-text text-muted">
                            <?= I18N::translate('Minimum 60 s, maximum 86400 s (24 h). Default: 900 s (15 min).') ?>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="input-group-text bg-light border-0 h-100 text-muted small">
                            <?php
                            $minuten = (int) ($cacheTtl / 60);
                            $stunden = (int) ($cacheTtl / 3600);
                            echo $stunden > 0
                                ? I18N::translate('%s hours', $stunden)
                                : I18N::translate('%s minutes', $minuten);
                            ?>
                        </div>
                    </div>
                </div>

                <!-- Einträge pro Seite -->
                <div class="mb-3 row">
                    <label for="per_page" class="col-sm-4 col-form-label fw-semibold">
                        <?= I18N::translate('Entries per page') ?>
                    </label>
                    <div class="col-sm-4">
                        <select id="per_page" name="per_page" class="form-select">
                            <?php foreach ([10, 25, 50, 100, 200] as $n) : ?>
                                <option value="<?= $n ?>" <?= $n === $perPage ? 'selected' : '' ?>>
                                    <?= $n ?>
                                </option>
                            <?php endforeach ?>
                        </select>
                    </div>
                </div>

            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>
                    <?= I18N::translate('Save settings') ?>
                </button>
            </div>
        </div>

    </form>

    <!-- Cache manuell leeren -->
    <div class="card border-warning mb-4">
        <div class="card-header fw-semibold text-warning">
            <i class="fas fa-trash-alt me-2"></i>
            <?= I18N::translate('Manage cache') ?>
        </div>
        <div class="card-body">
            <p class="mb-3 text-muted">
                <?= I18N::translate(
                    'Clears the module\'s APCu cache. Necessary after manual database changes or when data appears not to update. The cache is cleared automatically after GEDCOM imports.'
                ) ?>
            </p>
            <form method="post" action="<?= e(route('sammlungen.admin.cache-clear')) ?>">
                <?= csrf_field() ?>
                <button type="submit"
                        class="btn btn-outline-warning"
                        onclick="return confirm('<?= I18N::translate('Really clear the cache?') ?>')">
                    <i class="fas fa-broom me-1"></i>
                    <?= I18N::translate('Clear cache now') ?>
                </button>
            </form>
        </div>
    </div>

    <!-- Sammlungen verwalten -->
    <div class="card">
        <div class="card-header fw-semibold">
            <i class="fas fa-layer-group me-2"></i>
            <?= I18N::translate('Collections') ?>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                <?= I18N::translate(
                    'Create manually maintained collections to group media objects by topic. Automatically detected collections from the GEDCOM media types are not affected.'
                ) ?>
            </p>

            <?php if ($trees->isEmpty()) : ?>
                <div class="alert alert-warning mb-0">
                    <?= I18N::translate('There are no family trees.') ?>
                </div>
            <?php elseif ($trees->count() === 1) : ?>
                <a href="<?= e(route('sammlungen.admin.sammlungen', ['tree' => $trees->first()->name()])) ?>"
                   class="btn btn-outline-primary">
                    <i class="fas fa-cog me-1"></i>
                    <?= I18N::translate('Manage collections') ?>
                </a>
            <?php else : ?>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <label for="sammlungen-tree-select" class="form-label mb-0 fw-semibold">
                        <?= I18N::translate('Family tree:') ?>
                    </label>
                    <select id="sammlungen-tree-select" class="form-select w-auto">
                        <?php foreach ($trees as $t) : ?>
                            <option value="<?= e(route('sammlungen.admin.sammlungen', ['tree' => $t->name()])) ?>">
                                <?= e($t->title()) ?>
                            </option>
                        <?php endforeach ?>
                    </select>
                    <a id="sammlungen-tree-link"
                       href="<?= e(route('sammlungen.admin.sammlungen', ['tree' => $trees->first()->name()])) ?>"
                       class="btn btn-outline-primary">
                        <i class="fas fa-cog me-1"></i>
                        <?= I18N::translate('Manage collections') ?>
                    </a>
                </div>
                <script>
                    document.getElementById('sammlungen-tree-select').addEventListener('change', function () {
                        document.getElementById('sammlungen-tree-link').href = this.value;
                    });
                </script>
            <?php endif ?>

        </div>
    </div>

</div>
