<?php

/**
 * Partial: Übersicht aller Sammlungen in drei gleichrangigen Abschnitten –
 * Archiv-Ordner, thematische Sammlungen, freier Bestand
 *
 * Erwartet aus Parent-Scope:
 *   $manuell, $automatisch
 *   $unverknuepftGesamt, $unverknuepft_typen, $unverknuepftUrl
 *   $sammlungUrl (Closure)
 *   $istAdmin, $tree, $treeName
 */

use Fisharebest\Webtrees\I18N;

?>

    <!-- ============================================================
         ÜBERSICHT – nur Ordner-Sammlungen + Nicht-eingebunden-Badge
    ============================================================ -->

        <!-- Filter-Leiste: nur Ordner-Sammlungen -->
        <?php if (count($manuell) > 1) : ?>
            <div class="d-flex flex-wrap gap-2 mb-4">
                <a href="<?= e(route('sammlungen.sammlungen', ['tree' => $treeName])) ?>"
                   class="btn btn-sm <?= $kategorie === '' ? 'btn-primary' : 'btn-outline-secondary' ?>">
                    <i class="fas fa-list me-1"></i><?= I18N::translate('All') ?>
                </a>
                <?php foreach ($manuell as $s) : ?>
                    <a href="<?= e($sammlungUrl($s->slug)) ?>"
                       class="btn btn-sm <?= $kategorie === $s->slug ? 'btn-primary' : 'btn-outline-secondary' ?>"
                       style="border-color:<?= e($s->farbe) ?>;
                              <?= $kategorie === $s->slug ? "background:{$s->farbe};border-color:{$s->farbe};" : '' ?>">
                        <i class="fas fa-<?= e($s->icon) ?> me-1"></i><?= e($s->name) ?>
                        <?php if ($s->anzahl !== null) : ?>
                            <span class="badge bg-white text-dark ms-1 small"><?= I18N::number($s->anzahl) ?></span>
                        <?php endif ?>
                    </a>
                <?php endforeach ?>
            </div>
        <?php endif ?>

        <!-- Kachelraster: gruppiert nach Typ -->
        <?php
        // Kanonisch = top-level Ordner (kein Slash). Unterverzeichnisse + manuell = thematisch.
        $kanonisch  = array_values(array_filter($manuell, fn ($s) =>
            $s->ordner !== null && $s->ordner !== '' && strpos($s->ordner, '/') === false
        ));
        $thematisch = array_values(array_filter($manuell, fn ($s) =>
            $s->ordner === null || $s->ordner === '' || strpos($s->ordner, '/') !== false
        ));
        ?>
        <?php if ($manuell === []) : ?>
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <?= I18N::translate('No collections created yet.') ?>
                <?php if ($istAdmin) : ?>
                    <a href="<?= e(route('sammlungen.admin.sammlungen', ['tree' => $tree->name()])) ?>" class="alert-link">
                        <?= I18N::translate('Create now') ?>
                    </a>
                <?php endif ?>
            </div>
        <?php else : ?>
            <?php if ($kanonisch !== []) : ?>
                <h5 class="text-muted mb-3 mt-2" style="font-size:.85rem;letter-spacing:.05em;text-transform:uppercase">
                    <i class="fas fa-folder me-1"></i><?= I18N::translate('Archive folders') ?>
                </h5>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-4">
                    <?php foreach ($kanonisch as $s) : ?>
                        <div class="col">
                        <a href="<?= e($sammlungUrl($s->slug)) ?>" class="text-decoration-none">
                            <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden archiv-card-hover"
                                 style="border-left:4px solid <?= e($s->farbe) ?> !important;">
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle"
                                         style="width:48px;height:48px;background:<?= e($s->farbe) ?>20">
                                        <i class="fas fa-<?= e($s->icon) ?> fs-5" style="color:<?= e($s->farbe) ?>"></i>
                                    </div>
                                    <div class="flex-grow-1 min-w-0">
                                        <h5 class="card-title mb-1 text-dark text-truncate"><?= e($s->name) ?></h5>
                                        <?php if ($s->anzahl !== null) : ?>
                                            <p class="card-text text-muted small mb-0">
                                                <?= I18N::plural('%s file', '%s files', $s->anzahl, I18N::number($s->anzahl)) ?>
                                            </p>
                                        <?php elseif ($s->beschreibung !== null) : ?>
                                            <p class="card-text text-muted small mb-0">
                                                <?= e(mb_strimwidth($s->beschreibung, 0, 90, '…')) ?>
                                            </p>
                                        <?php endif ?>
                                    </div>
                                </div>
                                <?php if ($s->vorschau !== []) : ?>
                                    <div class="card-footer bg-transparent border-0 pt-0 d-flex gap-1">
                                        <?php foreach (array_slice($s->vorschau, 0, 3) as $xref) : ?>
                                            <img src="<?= e(route(\Fisharebest\Webtrees\Http\RequestHandlers\MediaFileThumbnail::class, [
                                                'tree' => $tree->name(), 'xref' => $xref, 'w' => 60, 'h' => 60,
                                            ])) ?>"
                                                 alt="" loading="lazy" class="rounded"
                                                 style="width:48px;height:48px;object-fit:cover"
                                                 onerror="this.style.display='none'">
                                        <?php endforeach ?>
                                    </div>
                                <?php endif ?>
                                <?php if (!$s->aktiv) : ?>
                                    <span class="position-absolute top-0 end-0 badge bg-secondary m-2">
                                        <?= I18N::translate('Inactive') ?>
                                    </span>
                                <?php endif ?>
                            </div>
                        </a>
                    </div>
                    <?php endforeach ?>
                </div>
            <?php endif ?>

            <?php if ($thematisch !== []) : ?>
                <h5 class="text-muted mb-3 mt-2" style="font-size:.85rem;letter-spacing:.05em;text-transform:uppercase">
                    <i class="fas fa-star me-1"></i><?= I18N::translate('Thematic collections') ?>
                </h5>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                    <?php foreach ($thematisch as $s) : ?>
                        <div class="col">
                            <a href="<?= e($sammlungUrl($s->slug)) ?>" class="text-decoration-none">
                                <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden archiv-card-hover"
                                     style="border:2px dashed <?= e($s->farbe) ?> !important;">
                                    <div class="card-body d-flex gap-3 align-items-start">
                                        <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle"
                                             style="width:48px;height:48px;background:<?= e($s->farbe) ?>20">
                                            <i class="fas fa-<?= e($s->icon) ?> fs-5" style="color:<?= e($s->farbe) ?>"></i>
                                        </div>
                                        <div class="flex-grow-1 min-w-0">
                                            <h5 class="card-title mb-1 text-dark text-truncate"><?= e($s->name) ?></h5>
                                            <?php if ($s->beschreibung !== null) : ?>
                                                <p class="card-text text-muted small mb-0">
                                                    <?= e(mb_strimwidth($s->beschreibung, 0, 90, '…')) ?>
                                                </p>
                                            <?php endif ?>
                                        </div>
                                    </div>
                                    <?php if (!$s->aktiv) : ?>
                                        <span class="position-absolute top-0 end-0 badge bg-secondary m-2">
                                            <?= I18N::translate('Inactive') ?>
                                        </span>
                                    <?php endif ?>
                                </div>
                            </a>
                        </div>
                    <?php endforeach ?>
                </div>
            <?php endif ?>
        <?php endif ?>

        <!-- ============================================================
             FREIER BESTAND – dritter Abschnitt, gleichrangig zu den beiden
             darüber. Vorher stand hier oben ein grauer Hinweisbalken, der bei
             null Objekten ganz verschwand: die Kategorie war dann weder zu
             sehen noch zu erklären, und wer sie suchte, fand nichts. Jetzt
             steht die Überschrift immer, und bei null sagt eine Zeile, warum
             nichts da ist.
        ============================================================ -->
        <h5 class="text-muted mb-3 mt-4" style="font-size:.85rem;letter-spacing:.05em;text-transform:uppercase">
            <i class="fas fa-folder-open me-1"></i><?= I18N::translate('Free holdings') ?>
        </h5>

        <?php
        // Gezählt wird vom Dateisystem her, nicht aus der Datenbank: ein Archiv
        // besteht in aller Regel aus Dateien, die gar kein Medienobjekt haben.
        // Wer nur Medienobjekte zählt, meldet null, während tausend Dateien
        // danebenliegen. Zu jedem Ordner die passende Sammlung heraussuchen,
        // damit die Kachel irgendwohin führt.
        $freiGesamt   = $freie_dateien['gesamt'] ?? 0;
        $freiJeOrdner = $freie_dateien['jeOrdner'] ?? [];
        $ordnerZuSlug = [];
        foreach ($manuell as $s) {
            if ($s->ordner !== null && $s->ordner !== '') {
                $ordnerZuSlug[$s->ordner] = $s->slug;
            }
        }
        ?>

        <?php if ($freiGesamt === 0) : ?>
            <p class="text-muted small mb-4">
                <?= I18N::translate('All media objects are linked to individuals or families.') ?>
            </p>
        <?php else : ?>
            <p class="text-muted small mb-3">
                <?= I18N::plural(
                    '%s file in the archive does not appear in the family tree.',
                    '%s files in the archive do not appear in the family tree.',
                    $freiGesamt,
                    I18N::number($freiGesamt)
                ) ?>
            </p>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-4">
                <?php foreach ($freiJeOrdner as $ordnerName => $anzahl) : ?>
                    <?php
                    $beschriftung = (string) $ordnerName !== ''
                        ? (string) $ordnerName
                        : I18N::translate('No type');
                    $slug = $ordnerZuSlug[$ordnerName] ?? null;
                    ?>
                    <div class="col">
                        <?php if ($slug !== null) : ?><a href="<?= e($sammlungUrl($slug)) ?>" class="text-decoration-none"><?php endif ?>
                            <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden archiv-card-hover"
                                 style="border-left:4px solid #6c757d !important;">
                                <div class="card-body">
                                    <h5 class="card-title mb-1 text-dark text-truncate"><?= e($beschriftung) ?></h5>
                                    <p class="card-text text-muted small mb-0">
                                        <?= I18N::plural('%s file', '%s files', $anzahl, I18N::number($anzahl)) ?>
                                    </p>
                                </div>
                            </div>
                        <?php if ($slug !== null) : ?></a><?php endif ?>
                    </div>
                <?php endforeach ?>
            </div>

            <?php if ($unverknuepftGesamt > 0) : ?>
                <p class="text-muted small mb-4">
                    <a href="<?= e($unverknuepftUrl()) ?>">
                        <?= I18N::plural(
                            '%s of them is a media object in webtrees',
                            '%s of them are media objects in webtrees',
                            $unverknuepftGesamt,
                            I18N::number($unverknuepftGesamt)
                        ) ?>
                    </a>
                </p>
            <?php endif ?>
        <?php endif ?>
